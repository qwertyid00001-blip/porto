---
import { portfolioData } from '../data/portfolio';

const waUrl = `https://wa.me/${portfolioData.contact.whatsappNumber}?text=${encodeURIComponent(portfolioData.contact.whatsappPrefilledMessage)}`;
---

<section class="relative pt-10 pb-20 md:pt-16 md:pb-32 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Hero Header / Headline Area -->
    <div class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-surface-card border border-surface-border mb-6">
        <span class="w-2.5 h-2.5 rounded-full bg-brand-lime animate-pulse"></span>
        <span data-bind="availability" class="text-xs font-semibold tracking-wide text-surface-muted uppercase">
          {portfolioData.personal.availability}
        </span>
      </div>

      <!-- Main Headline with Inspiration Styling -->
      <p class="text-lg md:text-xl font-medium text-surface-muted mb-2 tracking-wide">
        Halo, Saya <span data-bind="name" class="text-brand-lime font-bold text-glow">{portfolioData.personal.name}</span>
      </p>
      
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white mb-6 leading-[1.15]">
        Web Developer untuk <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-200 to-brand-lime">
          Bisnis & Startup
        </span>
      </h1>

      <p data-bind="headline" class="text-base sm:text-lg text-surface-muted max-w-2xl mx-auto leading-relaxed">
        {portfolioData.personal.headline} {portfolioData.personal.subheadline}
      </p>
    </div>

    <!-- Center Stage Visual Container with Floating Proof Badges -->
    <div class="relative max-w-4xl mx-auto flex flex-col items-center justify-center">
      
      <!-- Central Ambient Spotlight -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none -z-10">
        <div class="w-72 sm:w-96 h-72 sm:h-96 rounded-full bg-blue-600/20 blur-[90px]"></div>
        <div class="w-60 sm:w-80 h-60 sm:h-80 rounded-full bg-brand-lime/10 blur-[80px]"></div>
      </div>

      <!-- Developer Silhouette / Portrait Frame -->
      <div class="relative w-64 h-72 sm:w-80 sm:h-96 rounded-3xl bg-gradient-to-b from-surface-card via-surface-card-subtle to-surface-bg border border-surface-border p-3 shadow-glow-card flex flex-col items-center justify-end overflow-hidden group">
        <!-- Abstract Modern Grid / Glow Inside Card -->
        <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:16px_16px] opacity-40"></div>
        <div class="absolute top-8 w-44 h-44 rounded-full bg-blue-500/10 blur-2xl"></div>

        <!-- Sleek Developer Illustration / Avatar -->
        <div class="relative z-10 w-full h-full flex flex-col items-center justify-center pt-4">
          <div class="w-32 h-32 sm:w-40 sm:h-40 rounded-full bg-gradient-to-tr from-brand-lime/20 via-surface-border to-blue-500/20 p-1 mb-3">
            <div class="w-full h-full rounded-full bg-surface-card flex items-center justify-center overflow-hidden border border-surface-border">
              <!-- Geometric Modern Monogram / Icon -->
              <div class="flex flex-col items-center justify-center">
                <span class="text-4xl sm:text-5xl font-black text-brand-lime font-mono">⚡</span>
                <span class="text-[10px] uppercase font-mono tracking-widest text-surface-muted mt-1 font-bold">Aan / Web Dev</span>
              </div>
            </div>
          </div>
          
          <div class="text-center px-4">
            <span class="inline-block px-3 py-1 rounded-full bg-brand-lime/10 text-brand-lime text-xs font-mono font-bold tracking-wider mb-1">
              FAST & CLEAN CODE
            </span>
            <p class="text-xs text-surface-muted">Zero Template Sampah • 100% Responsif</p>
          </div>
        </div>

        <!-- Overlaid Center Pill Button -->
        <div class="absolute bottom-4 z-20 w-auto">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-brand-lime hover:bg-brand-lime-light text-surface-bg font-extrabold text-sm uppercase tracking-wider transition-all duration-300 shadow-glow-lime transform hover:scale-105 active:scale-95"
          >
            <span>Lihat Proyek</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <polyline points="19 12 12 19 5 12"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <!-- Floating Badge 1 (Left): Lighthouse & Real Performance Metrics -->
      <div class="md:absolute md:left-4 lg:left-0 md:top-12 mt-6 md:mt-0 w-full sm:w-72 p-4 rounded-2xl bg-surface-card/90 backdrop-blur-xl border border-surface-border shadow-2xl hover:border-surface-border-highlight transition-all duration-300 transform md:-rotate-2 hover:rotate-0">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-9 h-9 rounded-xl bg-green-500/10 border border-green-500/20 flex items-center justify-center text-green-400 font-bold text-base">
            ⚡
          </div>
          <div>
            <h4 class="text-sm font-bold text-white">Lighthouse 98+</h4>
            <p class="text-[11px] text-green-400 font-medium">Core Web Vitals Pass</p>
          </div>
        </div>
        <p class="text-xs text-surface-muted leading-relaxed">
          Website ringan di HP, waktu muat &lt; 1.5 detik, dan siap menaikkan ranking Google & kenyamanan calon pelanggan.
        </p>
      </div>

      <!-- Floating Badge 2 (Right): Quality & Modern Architecture -->
      <div class="md:absolute md:right-4 lg:right-0 md:top-20 mt-4 md:mt-0 w-full sm:w-72 p-4 rounded-2xl bg-surface-card/90 backdrop-blur-xl border border-surface-border shadow-2xl hover:border-surface-border-highlight transition-all duration-300 transform md:rotate-2 hover:rotate-0">
        <div class="flex items-center justify-between mb-3 border-b border-surface-border pb-2">
          <span class="text-xs font-bold text-surface-muted uppercase tracking-wider">Kualitas Pengerjaan</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-brand-lime/10 text-brand-lime font-bold">Teruji</span>
        </div>
        
        <!-- Progress Bars (Modifikasi dari inspirasi dengan metrik kualitas profesional) -->
        <div class="space-y-2.5">
          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-300 font-medium">Clean Code & No Bloat</span>
              <span class="text-brand-lime font-mono font-bold">100%</span>
            </div>
            <div class="w-full h-1.5 rounded-full bg-surface-border overflow-hidden">
              <div class="h-full bg-brand-lime rounded-full w-full"></div>
            </div>
          </div>
          
          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-300 font-medium">Mobile Responsive</span>
              <span class="text-brand-lime font-mono font-bold">100%</span>
            </div>
            <div class="w-full h-1.5 rounded-full bg-surface-border overflow-hidden">
              <div class="h-full bg-brand-lime rounded-full w-full"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-300 font-medium">SEO & Aksesibilitas</span>
              <span class="text-brand-lime font-mono font-bold">98%</span>
            </div>
            <div class="w-full h-1.5 rounded-full bg-surface-border overflow-hidden">
              <div class="h-full bg-brand-lime rounded-full w-[98%]"></div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Quick Action Dual Button Bar below Hero -->
    <div class="mt-12 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 px-7 py-3 rounded-full bg-brand-lime hover:bg-brand-lime-light text-surface-bg font-extrabold text-sm uppercase tracking-wider transition-all duration-300 shadow-glow-lime transform hover:scale-105 active:scale-95"
      >
        <span>Mulai Proyek Sekarang</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <a
        href={waUrl}
        data-bind="wa-link"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-surface-card hover:bg-surface-card-subtle border border-surface-border hover:border-brand-lime/60 text-white font-semibold text-sm transition-all duration-300 transform hover:scale-105"
      >
        <span class="text-brand-lime">💬</span>
        <span>Chat WhatsApp Langsung</span>
      </a>
    </div>

  </div>
</section>

