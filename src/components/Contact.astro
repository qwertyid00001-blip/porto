---
import { portfolioData } from '../data/portfolio';

const waUrl = `https://wa.me/${portfolioData.contact.whatsappNumber}?text=${encodeURIComponent(portfolioData.contact.whatsappPrefilledMessage)}`;
---

<section id="contact" class="py-20 md:py-32 relative border-t border-surface-border/60">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-brand-lime font-mono text-xs font-bold uppercase tracking-widest block mb-2">
        // HUBUNGI SAYA
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight uppercase leading-tight">
        MARI DISKUSIKAN <br />
        <span class="text-brand-lime text-glow">PROYEK WEBSITE ANDA</span>
      </h2>
      <p class="mt-4 text-surface-muted text-sm sm:text-base leading-relaxed">
        Punya ide proyek, ingin upgrade website yang lemot, atau butuh landing page konversi? Kirim pesan lewat form atau WhatsApp langsung.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Direct WhatsApp & Value (4 cols) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Direct WhatsApp Card (High Priority according to PRD FR-4) -->
        <div class="p-6 sm:p-8 rounded-3xl bg-surface-card border border-brand-lime/50 shadow-glow-lime flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-brand-lime/10 border border-brand-lime/30 flex items-center justify-center text-2xl mb-4">
              💬
            </div>
            <h3 class="text-xl font-extrabold text-white mb-2">
              Respon Tercepat via WhatsApp
            </h3>
            <p class="text-xs text-surface-muted leading-relaxed mb-6">
              Lebih suka obrolan santai dan cepat? Klik tombol di bawah untuk langsung terhubung dengan pesan yang sudah disiapkan.
            </p>
          </div>

          <a
            href={waUrl}
            data-bind="wa-link"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-brand-lime hover:bg-brand-lime-light text-surface-bg font-extrabold text-xs uppercase tracking-wider transition-all duration-300 transform hover:scale-105 active:scale-95 shadow-md"
          >
            <span>Kirim Pesan WhatsApp</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- Contact Points Card -->
        <div class="p-6 rounded-3xl bg-surface-card border border-surface-border space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-surface-card-subtle border border-surface-border flex items-center justify-center text-brand-lime font-mono text-sm">
              ✉
            </div>
            <div>
              <span class="text-[10px] font-mono uppercase text-surface-muted">Email Langsung</span>
              <p data-bind="email-text" class="text-xs font-semibold text-white">{portfolioData.contact.email}</p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-surface-card-subtle border border-surface-border flex items-center justify-center text-brand-lime font-mono text-sm">
              📍
            </div>
            <div>
              <span class="text-[10px] font-mono uppercase text-surface-muted">Lokasi / Zona Waktu</span>
              <p class="text-xs font-semibold text-white">Indonesia (WIB / GMT+7)</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Form matching Inspiration Container (7 cols) -->
      <div class="lg:col-span-7 bg-white text-surface-bg rounded-3xl p-6 sm:p-10 shadow-2xl relative">
        <h3 class="text-2xl font-black text-slate-900 tracking-tight uppercase mb-2 text-center sm:text-left">
          LET'S HAVE A CHAT
        </h3>
        <p class="text-xs text-slate-600 mb-6 text-center sm:text-left">
          Isi detail singkat di bawah dan saya akan membalas dalam waktu maksimal 24 jam.
        </p>

        <!-- Functional Contact Form with Validation & Honeypot (FR-3) -->
        <form id="contact-form" class="space-y-4">
          <!-- Honeypot anti-spam field -->
          <div class="hidden" aria-hidden="true">
            <label for="honeypot">Jangan isi kolom ini:</label>
            <input type="text" id="honeypot" name="honeypot" tabindex="-1" autocomplete="off" />
          </div>

          <div>
            <label for="name" class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">
              Nama Lengkap *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Misal: Budi Santoso"
              class="w-full px-4 py-3 rounded-xl bg-slate-100 border border-slate-200 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-lime-dark focus:bg-white transition-all"
            />
          </div>

          <div>
            <label for="email" class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">
              Alamat Email *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="budi@contohbisnis.com"
              class="w-full px-4 py-3 rounded-xl bg-slate-100 border border-slate-200 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-lime-dark focus:bg-white transition-all"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="service-type" class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">
                Kebutuhan
              </label>
              <select
                id="service-type"
                name="service_type"
                class="w-full px-4 py-3 rounded-xl bg-slate-100 border border-slate-200 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-lime-dark focus:bg-white transition-all"
              >
                <option value="Landing Page">Landing Page Konversi</option>
                <option value="Company Profile">Company Profile</option>
                <option value="Web Application / MVP">Web Application / MVP</option>
                <option value="Konsultasi / Lainnya">Konsultasi / Lainnya</option>
              </select>
            </div>

            <div>
              <label for="budget" class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">
                Estimasi Anggaran
              </label>
              <select
                id="budget"
                name="budget"
                class="w-full px-4 py-3 rounded-xl bg-slate-100 border border-slate-200 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-lime-dark focus:bg-white transition-all"
              >
                <option value="Rp 1.5jt - Rp 3jt">Rp 1.500.000 – Rp 3.000.000</option>
                <option value="Rp 3jt - Rp 6jt">Rp 3.000.000 – Rp 6.000.000</option>
                <option value="> Rp 6jt">> Rp 6.000.000</option>
                <option value="Belum Tentu">Belum Ditentukan</option>
              </select>
            </div>
          </div>

          <div>
            <label for="message" class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-1">
              Ceritakan Kebutuhan Proyek Anda *
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder="Jelaskan jenis bisnis, referensi website yang disukai, atau kendala yang dihadapi saat ini..."
              class="w-full px-4 py-3 rounded-xl bg-slate-100 border border-slate-200 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-lime-dark focus:bg-white transition-all resize-none"
            ></textarea>
          </div>

          <!-- Submit Button matching Inspiration Shape -->
          <button
            type="submit"
            id="submit-btn"
            class="w-full py-4 rounded-full bg-brand-lime hover:bg-brand-lime-light text-slate-900 font-black text-sm uppercase tracking-wider transition-all duration-300 shadow-lg transform hover:scale-[1.01] active:scale-[0.99] focus:outline-none focus:ring-2 focus:ring-slate-900"
          >
            KIRIM PESAN SEKARANG
          </button>

          <!-- Feedback Status Notification -->
          <div id="form-feedback" class="hidden p-3 rounded-xl text-center text-xs font-semibold"></div>
        </form>
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-btn');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const honeypot = (document.getElementById('honeypot') as HTMLInputElement)?.value;
    if (honeypot) {
      // Spam bot detected silently
      return;
    }

    if (submitBtn) {
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.textContent = 'MENGIRIM...';
    }

    // Simulate reliable dispatch or webhook integration
    setTimeout(() => {
      if (feedback) {
        feedback.className = 'p-3 rounded-xl text-center text-xs font-semibold bg-green-100 text-green-800 border border-green-200 block';
        feedback.textContent = 'Terima kasih! Pesan Anda telah terkirim. Saya akan membalas ke email Anda dalam waktu 24 jam.';
      }
      form.reset();
      if (submitBtn) {
        submitBtn.removeAttribute('disabled');
        submitBtn.textContent = 'PESAN TERKIRIM ✓';
      }
    }, 1000);
  });
</script>

