---
import { portfolioData } from '../data/portfolio';
---

<section id="skills" class="py-20 md:py-32 relative border-t border-surface-border/60">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title in Lime from Inspiration -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-brand-lime font-mono text-xs font-bold uppercase tracking-widest block mb-2">
        // TEKNOLOGI
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-brand-lime tracking-tight text-glow">
        KEAHLIAN SAYA
      </h2>
      <p class="mt-4 text-surface-muted text-base sm:text-lg">
        Stack modern yang dipilih untuk menghasilkan situs statis super cepat, interaktif, dan mudah dirawat.
      </p>
    </div>

    <!-- Main Skills Layout (Grid on Left + Highlight Card on Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 max-w-5xl mx-auto mb-10">
      
      <!-- Core Skills 8-Card Grid (Left 2 cols) -->
      <div class="lg:col-span-2 grid grid-cols-2 sm:grid-cols-4 gap-4">
        {portfolioData.skills.core.map((skill) => (
          <div class="group p-5 rounded-2xl bg-surface-card border border-surface-border hover:border-brand-lime/60 transition-all duration-300 flex flex-col items-center justify-center text-center hover:scale-105 shadow-sm">
            <!-- Icon Placeholder / Monogram -->
            <div class="w-12 h-12 rounded-xl bg-surface-card-subtle border border-surface-border group-hover:border-brand-lime flex items-center justify-center mb-3 transition-colors">
              <span class="text-lg font-black font-mono text-brand-lime">
                {skill.name.slice(0, 2).toUpperCase()}
              </span>
            </div>
            <h4 class="text-sm font-bold text-white group-hover:text-brand-lime transition-colors">
              {skill.name}
            </h4>
            <span class="text-[10px] text-surface-muted mt-1 leading-tight">
              {skill.level}
            </span>
          </div>
        ))}
      </div>

      <!-- Feature Highlight Card (Right col - Modifikasi dari "4 Years Experience") -->
      <div class="p-8 rounded-2xl bg-gradient-to-b from-surface-card to-surface-card-subtle border border-surface-border-highlight flex flex-col justify-between items-center text-center relative overflow-hidden group shadow-glow-card">
        <div class="absolute -top-12 -right-12 w-36 h-36 bg-brand-lime/10 rounded-full blur-2xl"></div>

        <div class="my-auto py-4">
          <div class="text-5xl sm:text-6xl font-black text-brand-lime font-mono tracking-tight mb-2 text-glow">
            100%
          </div>
          <h4 class="text-lg font-bold text-white mb-2">
            Fokus Performa & Mutu
          </h4>
          <p class="text-xs text-surface-muted leading-relaxed">
            Tanpa klaim jam terbang palsu. Bukti utama adalah kode bersih yang lolos audit Lighthouse dan responsif di berbagai ukuran layar.
          </p>
        </div>

        <a
          href={portfolioData.contact.github}
          data-bind="github"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-brand-lime hover:bg-brand-lime-light text-surface-bg font-extrabold text-xs uppercase tracking-wider transition-all duration-300 transform hover:scale-105 shadow-glow-lime"
        >
          <span>Buka Repositori GitHub</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>

    </div>

    <!-- Additional Skills Card (From Inspiration) -->
    <div class="max-w-5xl mx-auto p-6 sm:p-8 rounded-2xl bg-surface-card/60 border border-surface-border text-center">
      <span class="text-xs font-mono font-bold text-brand-lime uppercase tracking-widest block mb-4">
        STANDAR & PRAKTIK TAMBAHAN
      </span>
      <div class="flex flex-wrap items-center justify-center gap-3">
        {portfolioData.skills.additional.map((item) => (
          <span class="px-4 py-2 rounded-full bg-surface-card-subtle border border-surface-border text-xs sm:text-sm font-medium text-slate-300 hover:text-white hover:border-brand-lime/40 transition-colors">
            {item}
          </span>
        ))}
      </div>
    </div>

  </div>
</section>

